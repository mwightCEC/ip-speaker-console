# Copy to server/.env to override the defaults. Every value is optional.

# Network address and port the console listens on.
# 127.0.0.1 keeps a development machine private; the device uses 0.0.0.0 so the LAN can reach it.
HOST=127.0.0.1
PORT=3000

# Fastify log level: fatal, error, warn, info, debug or trace.
LOG_LEVEL=info

# Audio back end: "mock" simulates playback, "aplay" plays through ALSA on the device.
AUDIO_DRIVER=mock

# System back end: "mock" simulates network and reboot, "linux" uses the real device.
SYSTEM_DRIVER=mock
